# Copy to .env (Docker Compose picks it up automatically) and fill in.
# Used by docker-compose.example.yml — see that file for the full picture.

# OAuth "Desktop app" client ID — Google Cloud Console →
# APIs & Services → Credentials → your Desktop client → Client ID.
# It's a public identifier (there is no secret for Desktop clients).
# If left empty, the app falls back to DEFAULT_CLIENT_ID in app/config.py.
GMAIL_OAUTH_CLIENT_ID=

# Host port the app is published on. Keep 8000: after authorising on
# Google, the browser is redirected to
# http://localhost:8000/auth/gmail/callback to finish the connection.
HOST_PORT=8000
