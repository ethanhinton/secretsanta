# Copy to .env (Docker Compose picks it up automatically) and fill in.
# Used by docker-compose.example.yml — see that file for the full picture.

# OAuth client ID — Google Cloud Console →
# APIs & Services → Credentials → your client → Client ID.
# A "Desktop app" client ID is a public identifier (no secret needed).
# If left empty, the app falls back to DEFAULT_CLIENT_ID in app/config.py.
GMAIL_OAUTH_CLIENT_ID=

# OAuth client secret — ONLY needed if your client is a "Web application"
# type (Google rejects the sign-in without it). Desktop clients have none;
# leave this blank for those. Google Cloud Console → your client →
# Client secret (the value starting with GOCSPX-).
GMAIL_OAUTH_CLIENT_SECRET=

# Host port the app is published on. Keep 8000: after authorising on
# Google, the browser is redirected to
# http://localhost:8000/auth/gmail/callback to finish the connection.
HOST_PORT=8000
